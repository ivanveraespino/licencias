{# templates/reportes/_tabla_resultados.html.twig #}


<script>
    $(document).ready(function() {
        $('#tabla-licencias').DataTable({
            // Organiza los botones a la izquierda y el buscador a la derecha usando Bootstrap 5
            dom: "<'row mb-3'<'col-sm-12 col-md-6'B><'col-sm-12 col-md-6'f>>" +
                 "<'row'<'col-sm-12'tr>>" +
                 "<'row mt-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: 'Exportar a Excel',
                    className: 'btn btn-success btn-sm me-2',
                    title: 'Reporte de Licencias',
                    // Exporta todas las columnas (incluso las ocultas 3 y 4)
                    exportOptions: { columns: ':all' } 
                },
                {
                    extend: 'pdfHtml5',
                    text: 'Exportar a PDF',
                    className: 'btn btn-danger btn-sm',
                    title: 'Reporte de Licencias',
                    orientation: 'portrait',
                    pageSize: 'LETTER',
                    // Exporta todas las columnas (incluso las ocultas 3 y 4)
                    exportOptions: { columns: ':all' } 
                }
            ],
            language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
            
            pageLength: 10,
            responsive: true,
            "createdRow": function(row, data, dataIndex) {
                $(row).css('font-size', '13px');
            }
        });
    });
</script>


{% if datos|length > 0 %}
    <div class="table-responsive p-3">
        <table id="tabla-licencias" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>Razón Social</th>
                    <th>Nombre del Negocio</th>
                    <th>Giro</th>
                    <th>Licencia</th>
                    <th>Emisión</th>
                </tr>
            </thead>
            <tbody>
                {% for fila in datos %}
                    <tr>
                        <td>{{ fila.razonsocial|default('N/A') }}</td>
                        <td>{{ fila.nombrenegocio }}</td>
                        <td>{{ fila.giro|length > 40 ? fila.giro|slice(0, 40) ~ '...' : fila.giro }}</td>
                        
                        <td>{{ fila.tipo == 0 ? 'ORDINARIA' : (fila.tipo == 1 ? 'ESPECIAL' : 'TEMPORAL') }}</td>
                        <td>{{ fila.inicio|date('d/m/Y') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

{% else %}
    <div class="alert alert-warning">
        No se encontraron resultados para los filtros seleccionados.
    </div>
{% endif %}
